{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Effect": "Allow",
   "Action": [
    "logs:CreateLogGroup",
    "logs:CreateLogStream",
    "logs:PutLogEvents"
   ],
   "Resource": "*"
  },
  {
   "Effect": "Allow",
   "Action": "dsql:DbConnect",
   "Resource": "arn:aws:dsql:${AWS_REGION}:${ACCOUNT_ID}:cluster/${CLUSTER_ID}"
  },
  {
   "Effect": "Allow",
   "Action": [
    "s3:GetObject",
    "s3:PutObject",
    "s3:DeleteObject"
   ],
   "Resource": "arn:aws:s3:::${BUCKET}/*"
  },
  {
   "Effect": "Allow",
   "Action": "ssm:GetParameter",
   "Resource": "arn:aws:ssm:${AWS_REGION}:${ACCOUNT_ID}:parameter/yohaku/*"
  },
  {
   "Effect": "Allow",
   "Action": [
    "cognito-idp:ListUsers",
    "cognito-idp:AdminCreateUser",
    "cognito-idp:AdminDeleteUser",
    "cognito-idp:AdminGetUser"
   ],
   "Resource": "arn:aws:cognito-idp:${AWS_REGION}:${ACCOUNT_ID}:userpool/${POOL_ID}"
  }
 ]
}